{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "how-rich-are-you",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "how-rich-are-you.aopv.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
